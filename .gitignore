*.swp

# ---------------------------------------------------------------- dev environment
#
# dev/fixtures/ is the fixture of record for the local environment. Everything
# under dev/config/ is a working copy that Home Assistant rewrites while it
# runs, so almost all of it is generated rather than committed.
# dev/seed.sh installs the fixtures; dev/reset.sh wipes and reinstalls them.

# Working copies generated from dev/fixtures/
dev/config/.storage/choremander.storage.*
dev/config/.storage/lovelace.parent_dashboard
dev/config/.storage/lovelace.kid_a_dashboard
dev/config/.storage/lovelace.kid_b_dashboard
dev/config/.storage/lovelace_dashboards

# Credentials and onboarding state, created by dev/bootstrap.py on first start
dev/config/.storage/auth
dev/config/.storage/auth_provider.homeassistant
dev/config/.storage/onboarding
dev/config/.storage/http
dev/config/.storage/http.auth
dev/config/.storage/person
dev/.token

# Rewritten by Home Assistant at runtime or created during onboarding; these
# hold no fixture value and would otherwise churn on every single run
dev/config/.storage/core.area_registry
dev/config/.storage/core.device_registry
dev/config/.storage/core.entity_registry
dev/config/.storage/core.restore_state
# Rewritten with fresh random ids every time the integration registers its
# cards, so it churned on literally every run while it was tracked.
dev/config/.storage/lovelace_resources
dev/config/.storage/lovelace.map
dev/config/.storage/assist_pipeline.pipelines
dev/config/.storage/bluetooth.passive_update_processor
dev/config/.storage/homeassistant.exposed_entities
dev/config/.storage/repairs.issue_registry
dev/config/.storage/trace.saved_traces

# Runtime files and optional add-ons
dev/config/custom_components/
dev/config/home-assistant_v2.db
dev/config/home-assistant_v2.db-shm
dev/config/home-assistant_v2.db-wal
dev/config/home-assistant.log
dev/config/home-assistant.log.*
dev/config/.ha_run.lock
dev/config/.HA_VERSION
dev/config/tts/
dev/config/blueprints/
dev/config/.cloud/

# ---------------------------------------------------------------- test harness

.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
.coverage
htmlcov/

e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# Stray Playwright output if the runner is invoked from the repo root
/test-results/

# Claude Code's scratch space. `worktrees/` holds full checkouts of this repo -
# 39MB of them at one point - which a `git add -A` would otherwise try to commit
# into the repo itself. Ignored as a directory so anything shareable that lands
# in .claude/ later (settings.json, agents) can still be tracked deliberately.
.claude/worktrees/
